+/**
+ * Backport of opennextjs/opennextjs-cloudflare#1318 (commit 9dbb209), applied to 1.20.16 with
+ * `pnpm patch`. Remove this patch once a released @opennextjs/cloudflare contains the fix.
+ */
+import path from "node:path";
+import { compareSemver } from "@opennextjs/aws/build/helper.js";
+import { applyRule, parseCode } from "@opennextjs/aws/build/patch/astCodePatcher.js";
+import { getCrossPlatformPathRegex } from "@opennextjs/aws/utils/regex.js";
+export const cacheComponentsSchedulerModule = "__opennext_cache_components_scheduler";
+const microtaskCheckpointFlag = "unhandled_rejection_after_microtask_checkpoint";
+const microtaskCheckpointDate = "2026-03-03";
+/**
+ * The flag is `experimental.dynamicIO` in Next.js 15.4, `experimental.cacheComponents` in 15.5 and
+ * `cacheComponents` from 16.0.
+ */
+export function isCacheComponentsEnabled(nextConfig) {
+    const config = nextConfig;
+    return Boolean(config.cacheComponents ?? config.experimental?.cacheComponents ?? config.experimental?.dynamicIO);
+}
+/** Next.js before 16.2 stages its renders with functions that are not covered. */
+export function needsCacheComponentsScheduler(buildOpts, nextConfig) {
+    return isCacheComponentsEnabled(nextConfig) && !compareSemver(buildOpts.nextVersion, "<", "16.2.0");
+}
+/**
+ * The scheduler finds the end of a render stage with the `unhandledrejection` event, which workerd
+ * dispatches at the end of the microtask checkpoint from this compatibility date or with this flag.
+ */
+export function hasMicrotaskCheckpoint(wranglerConfig) {
+    const flags = wranglerConfig.compatibility_flags ?? [];
+    if (flags.includes(`no_${microtaskCheckpointFlag}`)) {
+        return false;
+    }
+    return (flags.includes(microtaskCheckpointFlag) ||
+        (wranglerConfig.compatibility_date ?? "") >= microtaskCheckpointDate);
+}
+export const microtaskCheckpointWarning = `Cache Components is enabled but workerd cannot report the end of a render stage: cached content can then render at request time instead of from the cache. Set \`compatibility_date\` to ${microtaskCheckpointDate} or later, or add the \`${microtaskCheckpointFlag}\` compatibility flag, in your wrangler config.`;
+const runnerContentFilter = /DANGEROUSLY_runPendingImmediatesAfterCurrentTask/;
+/**
+ * The runner is compiled into the app page runtimes, into the server chunks when the bundler inlines
+ * the runtime, and stays a standalone module for the callers that are not part of a runtime.
+ */
+export const runnerFileFilter = getCrossPlatformPathRegex(String.raw `/(?:next/dist/compiled/next-server/app-page(?:-turbo)?(?:-experimental)?\.runtime\.prod|\.next/server/chunks/.+|next/dist/(?:esm/)?server/app-render/app-render-render-utils)\.js$`, { escape: false });
+export function patchCacheComponents(updater, buildOpts, nextConfig) {
+    if (!needsCacheComponentsScheduler(buildOpts, nextConfig)) {
+        return { name: "patch-cache-components", setup() { } };
+    }
+    let patchedFiles = 0;
+    updater.updateContent("cache-components-scheduler", [
+        {
+            filter: runnerFileFilter,
+            contentFilter: runnerContentFilter,
+            callback: async ({ contents, path: filePath }) => {
+                patchedFiles++;
+                return patchRunInSequentialTasks(contents, filePath);
+            },
+        },
+    ]);
+    return {
+        name: "patch-cache-components",
+        setup(build) {
+            build.onResolve({ filter: new RegExp(`^${cacheComponentsSchedulerModule}$`) }, () => ({
+                path: path.join(buildOpts.outputDir, "cloudflare-templates/cache-components-scheduler.js"),
+            }));
+            build.onEnd((result) => {
+                if (result.errors.length === 0 && patchedFiles === 0) {
+                    throw new Error(`Cache Components is enabled but \`runInSequentialTasks\` was not found in Next.js ${buildOpts.nextVersion}. The app would render incomplete responses on Workers. Please report this to @opennextjs/cloudflare.`);
+                }
+            });
+        },
+    };
+}
+export function patchRunInSequentialTasks(code, filePath) {
+    const root = parseCode(code);
+    const { edits } = applyRule(runInSequentialTasksRule, root);
+    if (edits.length !== 1) {
+        throw new Error(`Expected one \`runInSequentialTasks\` in ${filePath} but found ${edits.length}. Please report this to @opennextjs/cloudflare with your Next.js version.`);
+    }
+    return root.commitEdits(edits);
+}
+/**
+ * The minifier renames the function and inlines its timer group, but both callees are properties of
+ * an external module and keep their names.
+ */
+export const runInSequentialTasksRule = `
+rule:
+  pattern:
+    selector: function_declaration
+    context: "function $FUNCTION($$$ARGS) { $$$BODY }"
+  all:
+    - has:
+        regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask
+        stopBy: end
+    - has:
+        regex: expectNoPendingImmediates
+        stopBy: end
+    - not:
+        has:
+          kind: function_declaration
+          stopBy: end
+          has:
+            regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask
+            stopBy: end
+fix: |-
+  function $FUNCTION(first, ...rest) {
+    return require("${cacheComponentsSchedulerModule}").runInSequentialTasks(first, ...rest);
+  }
+`;
