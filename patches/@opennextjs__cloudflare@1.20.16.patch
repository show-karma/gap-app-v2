+// Backport of opennextjs/opennextjs-cloudflare#1318 (pnpm patch): fail the build when the rule
+// stops matching instead of shipping a Worker whose overlapping requests can hang.
+export function patchModuleLoadingSignal(nextConfig) {
+    const cacheComponents = isCacheComponentsEnabled(nextConfig);
+    return {
+        name: "patch-module-loading-signal",
+        patches: [
+            {
+                versions: ">=15.4.0",
+                pathFilter: getCrossPlatformPathRegex(String.raw `/server/app-render/module-loading/track-module-loading\.instance\.js$`, { escape: false }),
+                contentFilter: /getModuleLoadingSignal/,
+                patchCode: async ({ code, filePath, buildOptions }) => {
+                    const root = parseCode(code);
+                    const { edits } = applyRule(moduleLoadingSignalRule, root);
+                    if (edits.length !== 1) {
+                        // Next.js tracks module loading only with Cache Components, so a miss is harmless without it.
+                        if (!cacheComponents) {
