# Packages must have been on the registry this long before we install them
# (the value is MINUTES, so 86400 = 60 days). Supply-chain guard against a
# freshly published compromised release. The threshold itself does not move;
# individual versions are admitted by dated exclusions below.
minimum-release-age=86400
minimum-release-age-exclude[]=ws

# Dated exclusions. Each admits a version that is ALREADY pinned in
# package.json and already present in pnpm-lock.yaml -- these let the lockfile
# be regenerated at all, they do not pull anything new in. Any resolution
# re-validates every direct dependency, so without them no dependency change
# of any kind can be lockfiled. Delete each entry once its version matures.
#
# next 16.3.3 and its siblings: published 2026-08-25, mature 2026-10-24.
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=@next/bundle-analyzer
minimum-release-age-exclude[]=@next/third-parties
minimum-release-age-exclude[]=@next/playwright
# @show-karma/karma-gap-sdk 0.4.29 (first-party): published 2026-07-20,
# mature 2026-09-18.
minimum-release-age-exclude[]=@show-karma/karma-gap-sdk

save-exact=true
