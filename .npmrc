# Packages must have been on the registry this long before we install them
# (the value is MINUTES, so 86400 = 60 days). Supply-chain guard against a
# freshly published compromised release. The threshold itself does not move;
# individual versions are admitted by the dated exclusions below.
minimum-release-age=86400
minimum-release-age-exclude[]=ws

# Dated exclusions. Every entry below names a package whose CURRENTLY LOCKED
# version is younger than 60 days, so without them no dependency change of any
# kind can be lockfiled: any resolution re-validates the whole graph, and pnpm
# rejects versions it already has locked. Each therefore admits only something
# already installed -- with these in place and no package.json change the
# lockfile regenerates byte-identical.
#
# Written out literally rather than as @next/* and @img/* globs on purpose: a
# glob would also admit package names that do not exist yet, which is a wider
# surface than the list below. These names can only ever admit future versions
# of packages we already ship. Delete each group once its version matures.
#
# next 16.3.3 and its platform binaries: published 2026-08-25, mature 2026-10-24.
minimum-release-age-exclude[]=@next/bundle-analyzer
minimum-release-age-exclude[]=@next/env
minimum-release-age-exclude[]=@next/playwright
minimum-release-age-exclude[]=@next/swc-darwin-arm64
minimum-release-age-exclude[]=@next/swc-darwin-x64
minimum-release-age-exclude[]=@next/swc-linux-arm64-gnu
minimum-release-age-exclude[]=@next/swc-linux-arm64-musl
minimum-release-age-exclude[]=@next/swc-linux-x64-gnu
minimum-release-age-exclude[]=@next/swc-linux-x64-musl
minimum-release-age-exclude[]=@next/swc-win32-arm64-msvc
minimum-release-age-exclude[]=@next/swc-win32-x64-msvc
minimum-release-age-exclude[]=@next/third-parties
minimum-release-age-exclude[]=next
#
# sharp 0.35.4 and its libvips 1.3.3 platform binaries (pulled in by next),
# published 2026-08-26, mature 2026-10-25.
minimum-release-age-exclude[]=@img/sharp-darwin-arm64
minimum-release-age-exclude[]=@img/sharp-darwin-x64
minimum-release-age-exclude[]=@img/sharp-freebsd-wasm32
minimum-release-age-exclude[]=@img/sharp-libvips-darwin-arm64
minimum-release-age-exclude[]=@img/sharp-libvips-darwin-x64
minimum-release-age-exclude[]=@img/sharp-libvips-linux-arm
minimum-release-age-exclude[]=@img/sharp-libvips-linux-arm64
minimum-release-age-exclude[]=@img/sharp-libvips-linux-ppc64
minimum-release-age-exclude[]=@img/sharp-libvips-linux-riscv64
minimum-release-age-exclude[]=@img/sharp-libvips-linux-s390x
minimum-release-age-exclude[]=@img/sharp-libvips-linux-x64
minimum-release-age-exclude[]=@img/sharp-libvips-linuxmusl-arm64
minimum-release-age-exclude[]=@img/sharp-libvips-linuxmusl-x64
minimum-release-age-exclude[]=@img/sharp-linux-arm
minimum-release-age-exclude[]=@img/sharp-linux-arm64
minimum-release-age-exclude[]=@img/sharp-linux-ppc64
minimum-release-age-exclude[]=@img/sharp-linux-riscv64
minimum-release-age-exclude[]=@img/sharp-linux-s390x
minimum-release-age-exclude[]=@img/sharp-linux-x64
minimum-release-age-exclude[]=@img/sharp-linuxmusl-arm64
minimum-release-age-exclude[]=@img/sharp-linuxmusl-x64
minimum-release-age-exclude[]=@img/sharp-wasm32
minimum-release-age-exclude[]=@img/sharp-webcontainers-wasm32
minimum-release-age-exclude[]=@img/sharp-win32-arm64
minimum-release-age-exclude[]=@img/sharp-win32-ia32
minimum-release-age-exclude[]=@img/sharp-win32-x64
minimum-release-age-exclude[]=sharp
#
# @emnapi/runtime 1.11.3 (under sharp): published 2026-07-25, mature 2026-09-23.
minimum-release-age-exclude[]=@emnapi/runtime
#
# nanoid 3.3.18 (under postcss): published 2026-08-07, mature 2026-10-06.
minimum-release-age-exclude[]=nanoid
#
# postcss 8.5.23: published 2026-07-24, mature 2026-09-22.
minimum-release-age-exclude[]=postcss
#
# @show-karma/karma-gap-sdk 0.4.29 (first-party): published 2026-07-20,
# mature 2026-09-18.
minimum-release-age-exclude[]=@show-karma/karma-gap-sdk

save-exact=true
